rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validData() {
      let d = request.resource.data;
      return d.keys().hasAll(['schema', 'nickname', 'payload', 'revision', 'updatedAt'])
        && d.keys().hasOnly(['schema', 'nickname', 'payload', 'revision', 'updatedAt'])
        && d.schema == 1
        && d.nickname is string
        && (d.nickname == '' || d.nickname.matches('^[가-힣a-zA-Z0-9_]{2,16}$'))
        && d.payload is string && d.payload.size() <= 700000
        && d.revision is int && d.revision >= 0
        && d.updatedAt == request.time;
    }
    match /users/{uid} {
      allow get: if owner(uid);
      allow list: if false;
      allow create: if owner(uid) && validData() && request.resource.data.revision == 0;
      allow update: if owner(uid) && validData()
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
